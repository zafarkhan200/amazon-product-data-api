# --- Authentication (required in production) ---
# api.market API Source: use API Key auth with header X-Origin-API-Key and this
# secret value. The origin rejects requests that do not carry the exact value.
ORIGIN_AUTH_HEADER=x-origin-api-key
ORIGIN_AUTH_SECRET=replace-with-a-long-random-secret

# For Bearer auth instead: ORIGIN_AUTH_HEADER=Authorization
# and ORIGIN_AUTH_SECRET="Bearer <token>".
# Optional: accept the credential as a query parameter instead of a header.
ORIGIN_AUTH_QUERY_PARAM=

# Local development only: set to true to call the API without a credential.
ALLOW_DIRECT_ACCESS=true

# --- Cache / rate limiting (Upstash Redis) ---
# If these are absent, an in-memory store is used for local development only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstream fetching ---
# Comma-separated rotating proxy URLs (http://user:pass@host:port). Optional.
PROXY_URLS=
# Third-party scraper template, e.g. http://api.scraperapi.com?api_key=KEY&url={url}
SCRAPER_API_URL=
# Unblocker fallback template, e.g. https://unblocker.example.com/?url={url}
UNBLOCKER_URL_TEMPLATE=
# Fetch timeout in milliseconds (default 12000)
FETCH_TIMEOUT_MS=12000
# Extra retries after the first attempt, on 403/429/503/captcha (default 2)
FETCH_RETRIES=2

# --- Limits ---
# Default plan when the gateway does not send a plan header (BASIC|PRO|ULTRA|MEGA)
DEFAULT_PLAN=BASIC
# Optional: header carrying the plan name, if your gateway forwards one.
PLAN_HEADER=
# Optional: header carrying the consumer id for the secondary limiter.
# Defaults to x-api-market-key, then x-forwarded-for.
CONSUMER_ID_HEADER=
# Optional overrides for the secondary per-consumer limiter (1 second window)
RATE_LIMIT_BASIC=1
RATE_LIMIT_PRO=5
RATE_LIMIT_ULTRA=10
RATE_LIMIT_MEGA=25

# --- Runtime ---
NODE_ENV=development
PORT=3000
